NODE_ENV=development

# Local Docker services
# Render supplies PORT automatically; SERVER_PORT is the local fallback.
SERVER_PORT=2500
CLIENT_PORT=2000
FRONTEND_URL=http://localhost:2000
PUBLIC_URL=http://localhost:2000
BACKEND_URL=http://localhost:2500
SWAGGER_ENABLED=true
KEEP_ALIVE_PING_PATH=/health/live
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_ACCESS_EXPIRES=15m
DATABASE_URL=postgresql://jaynstan:jaynstan@localhost:2555/jaynstan
REDIS_URL=redis://localhost:2525

# Google OAuth (configure before enabling sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:2500/api/auth/google/callback

# Superadmin seed (configure before the seed workflow is added)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-before-use

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo email delivery
MAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JaynStan
EMAIL_LOGO_URL=
SUPPORT_EMAIL=support@example.com
